  }
  :global(.bits-row) {
    position: relative;
    display: flex;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  :global(.bit-seg) {
    flex-basis: 0;
    min-width: 2.2rem;
    padding: var(--s2) var(--s1);
    text-align: center;
    border-left: 1px solid var(--rule);
  }
  :global(.bit-seg:first-child) {
    border-left: 0;
  }
  :global(.bit-seg b) {
    display: block;
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--ink-muted);
  }
  :global(.bit-sync) {
    flex-grow: 0 !important;
    background: var(--surface-2, var(--bg));
  }
  :global(.bit-prop) {
