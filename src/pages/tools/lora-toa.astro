---
import ToolLayout from '../../components/ToolLayout.astro';
import NumberInput from '../../components/NumberInput.astro';
import ResultRow from '../../components/ResultRow.astro';
import Segmented from '../../components/Segmented.astro';
import SelectInput from '../../components/SelectInput.astro';
import Toggle from '../../components/Toggle.astro';
import { REGIONS } from '../../lib/lorawan-regions';
import { toolUrl } from '../../utils/paths';

const references = [
  {
    title: 'Semtech, SX1276/77/78/79 Datasheet Rev. 7 (May 2020), §4.1.1.6 Low Data Rate Optimization and §4.1.1.7 Time on air',
    href: 'https://www.semtech.com/products/wireless-rf/lora-connect/sx1276',
  },
  { title: 'Semtech, AN1200.13 — LoRa Modem Designer’s Guide' },
  {
    title: 'LoRa Alliance, RP002-1.0.4 LoRaWAN Regional Parameters',
    href: 'https://resources.lora-alliance.org/technical-specifications/rp002-1-0-4-regional-parameters',
    note: 'data-rate and maximum-payload tables for EU868, US915, AU915, AS923, KR920, IN865',
  },
  { title: 'LoRa Alliance, TS001-1.0.4 LoRaWAN L2 Specification §4 — MAC message formats', note: 'MHDR, FHDR, FPort, MIC' },
  { title: 'ETSI EN 300 220-2 — Short Range Devices, 25 MHz to 1 GHz', note: 'EU868 sub-band duty cycles' },
  {
    title: 'The Things Network — Duty Cycle and Fair Use Policy',
    href: 'https://www.thethingsnetwork.org/docs/lorawan/duty-cycle/',
  },
];

const regionOptions = REGIONS.map((r) => ({ value: r.id, label: r.name }));
---

<ToolLayout slug="lora-toa" references={references}>
  <form id="lora-form" novalidate>
    <div class="tool-grid">
      <div class="panel">
        <h2 class="panel-title">Radio parameters</h2>
        <div class="fields fields--wide">
          <Segmented
            name="sf"
            label="Spreading factor"
            value="7"
            options={[7, 8, 9, 10, 11, 12].map((s) => ({ value: String(s), label: `SF${s}` }))}
          />
          <Segmented
            name="bw"
            label="Bandwidth"
            value="125"
            options={[
              { value: '125', label: '125 kHz' },
              { value: '250', label: '250 kHz' },
              { value: '500', label: '500 kHz' },
            ]}
          />
          <Segmented
            name="cr"
            label="Coding rate"
            value="1"
            options={[
              { value: '1', label: '4/5' },
              { value: '2', label: '4/6' },
              { value: '3', label: '4/7' },
              { value: '4', label: '4/8' },
            ]}
          />
        </div>
        <div class="fields" style="margin-top: var(--s4)">
          <NumberInput name="payload" label="Payload length" value="20" unit="B" inputmode="numeric" help="PHY payload, 0–255 bytes" />
          <NumberInput name="preamble" label="Preamble length" value="8" unit="sym" inputmode="numeric" help="Programmed symbols; LoRaWAN uses 8" />
        </div>
        <div class="fields fields--wide" style="margin-top: var(--s4)">
          <Toggle name="lw" label="Payload is application payload (add 13 B LoRaWAN overhead)" help="MHDR 1 + FHDR 7 + FPort 1 + MIC 4 bytes, no FOpts" />
          <Segmented
            name="hdr"
            label="Header"
            options={[
              { value: 'explicit', label: 'Explicit' },
              { value: 'implicit', label: 'Implicit' },
            ]}
          />
          <Toggle name="crc" label="Payload CRC on" checked help="LoRaWAN uplinks: on; downlinks: off" />
          <Segmented
            name="ldro"
            label="Low data rate optimisation (LDRO)"
            options={[
              { value: 'auto', label: 'Auto' },
              { value: 'on', label: 'On' },
              { value: 'off', label: 'Off' },
            ]}
          />
          <Segmented
            name="dc"
            label="Duty cycle"
            value="1"
            options={[
              { value: '0.1', label: '0.1 %' },
              { value: '1', label: '1 %' },
              { value: '10', label: '10 %' },
            ]}
          />
        </div>
      </div>

      <section class="panel" aria-labelledby="lora-results">
        <h2 class="panel-title" id="lora-results">Results</h2>
        <dl class="results">
          <ResultRow label="Time on air" name="toa" unit="ms" primary />
          <ResultRow label="Symbol time Tsym" name="tsym" />
          <ResultRow label="Preamble time" name="tpre" />
          <ResultRow label="Payload symbols" name="npay" />
          <ResultRow label="Payload time" name="tpay" />
          <ResultRow label="PHY payload length" name="pl" unit="B" />
          <ResultRow label="LDRO in effect" name="ldroState" />
          <ResultRow label="Raw bit rate Rb (modulation, no overhead)" name="rb" />
          <ResultRow label="Effective payload rate (8·PL / ToA, PHY payload)" name="reff" />
          <ResultRow label="Minimum off time for the duty cycle" name="off" />
          <ResultRow label="Max messages per hour (duty cycle)" name="mph" />
          <ResultRow label="Max messages per day (duty cycle)" name="mpd" />
          <ResultRow label="Max messages per day, TTN 30 s/day fair use" name="ttn" />
        </dl>
        <p class="note note--warn" id="ldro-note" hidden></p>
        <p class="note note--warn" id="dwell-note" hidden></p>

        <figure class="airbar" aria-labelledby="airbar-cap">
          <svg viewBox="0 0 1000 28" preserveAspectRatio="none" role="img" aria-labelledby="airbar-cap" id="airbar-svg">
            <rect x="0" y="0" width="1000" height="28" fill="var(--rule)"></rect>
          </svg>
          <figcaption id="airbar-cap">
            <span class="lg"><span class="sw sw--pre"></span>Preamble <span data-result="vpre">—</span></span>
            <span class="lg"><span class="sw sw--hdr"></span>Header block (first 8 symbols) <span data-result="vhdr">—</span></span>
            <span class="lg"><span class="sw sw--pay"></span>Rest of payload <span data-result="vpay">—</span></span>
          </figcaption>
        </figure>
      </section>
    </div>

    <section class="section" aria-labelledby="sf-title">
      <div class="sec-head">
        <h2 id="sf-title">Same packet at every spreading factor</h2>
        <button class="copy-btn" type="button" id="sf-copy" data-copy-text="" aria-label="Copy spreading factor table">Copy table</button>
      </div>
      <div class="table-wrap">
        <table class="data">
          <thead>
            <tr>
              <th>SF</th>
              <th>LDRO</th>
              <th class="num">Tsym</th>
              <th class="num">Payload sym</th>
              <th class="num">Time on air</th>
              <th class="num">Off time</th>
              <th class="num">Msgs/day (<span data-result="dcLabel">1 %</span>)</th>
              <th class="num">Msgs/day (TTN 30 s)</th>
            </tr>
          </thead>
          <tbody id="sf-body"></tbody>
        </table>
      </div>
      <p class="note">Bandwidth, coding rate, payload and header settings are kept; LDRO Auto is re-evaluated for each SF.</p>
    </section>

    <section class="section" aria-labelledby="lw-title">
      <h2 id="lw-title">LoRaWAN data rates and maximum payload</h2>
      <div class="fields">
        <SelectInput name="region" label="Region" options={regionOptions} value="eu868" />
        <div id="dwell-field">
          <Toggle name="dwell" label="UplinkDwellTime = 1 (400 ms limit)" help="Set by the network via TxParamSetupReq" />
        </div>
        <Toggle name="rep" label="Repeater-compatible limits" help="Default: device never operates behind a repeater" />
      </div>
      <p class="note" id="region-note"></p>
      <p class="note" id="region-match" aria-live="polite"></p>
      <div class="table-wrap">
        <table class="data">
          <thead>
            <tr>
              <th>DR</th>
              <th>Modulation</th>
              <th>Direction</th>
              <th class="num">Max M</th>
              <th class="num">Max N</th>
              <th class="num">ToA at max N</th>
              <th class="num">ToA, your payload</th>
              <th></th>
            </tr>
          </thead>
          <tbody id="dr-body"></tbody>
        </table>
      </div>
      <p class="note">
        M = maximum MACPayload, N = maximum application payload without FOpts (N = M − 8); the PHY payload is M + 5
        (MHDR + MIC). ToA columns use your coding rate, preamble, header and CRC settings. Only LoRa data rates are
        listed; FSK and LR-FHSS rates are omitted. Values: <span id="region-src"></span>.
      </p>
    </section>
  </form>

  <Fragment slot="formula">
    <pre>Tsym      = 2^SF / BW
Tpreamble = (Npreamble + 4.25) · Tsym
Npayload  = 8 + max( ceil( (8·PL − 4·SF + 28 + 16·CRC − 20·IH) / (4·(SF − 2·DE)) ) · (CR + 4), 0 )
Tpayload  = Npayload · Tsym
ToA       = Tpreamble + Tpayload

PL  = PHY payload bytes          IH = 1 implicit header, 0 explicit
CRC = 1 when payload CRC is on   DE = 1 when LDRO is on (Auto: Tsym &gt; 16 ms)
CR  = 1…4 for 4/5…4/8

Raw bit rate        Rb = SF · (BW / 2^SF) · 4 / (4 + CR)
Effective rate         = 8 · PL / ToA
Duty-cycle off time    = ToA · (1/dc − 1)
Messages per period    = floor(period · dc / ToA)
TTN fair use per day   = floor(30 s / ToA)
LoRaWAN PHY payload    = application payload + 13 B (MHDR 1 + FHDR 7 + FPort 1 + MIC 4)</pre>
    <p>
      This is the SX127x formula from the SX1276 datasheet §4.1.1.7 and AN1200.13, valid for SF7–SF12 at 125, 250 and
      500 kHz, the settings LoRaWAN uses. SX127x SF6 and the SX126x SF5/SF6 modes have a different overhead and are not
      covered here; for SX126x radios check the airtime against Semtech's SX126x driver. The FHDR is 7 bytes
      only when FOpts is empty; piggy-backed MAC commands add up to 15 bytes.
    </p>
  </Fragment>

  <Fragment slot="explainer">
    <h2>Reading LoRa airtime numbers</h2>
    <p>
      Every step up in spreading factor doubles the symbol time, so the same 20-byte packet that takes 56.6 ms at SF7
      takes well over a second at SF12. Airtime is what you pay for: the radio's transmit current (tens of mA at +14 dBm)
      flows for the whole time on air, so an SF12 node spends roughly 20–25 times more charge per uplink than an SF7 node
      sending the same data. That is why a device stuck at SF12 can drain a coin cell in months instead of years. Use the
      <a href={toolUrl('battery-life')}>battery life calculator</a> with the ToA above to see the effect on your budget.
    </p>
    <h3>Duty cycle is a regulation; fair use is a community policy</h3>
    <p>
      In Europe, ETSI EN 300 220 limits how long a device may transmit in each sub-band: 1 % on the 868.0–868.6 MHz
      default LoRaWAN channels, 0.1 % or 10 % in others. A 1 % duty cycle means that after a 1 s packet the device must
      stay silent on that sub-band for 99 s, which is the off time shown above. LoRaWAN stacks enforce this per band. The
      Things Network's 30 seconds of uplink airtime per device per day is a separate, much stricter fair-use policy of a
      free community network, not a legal limit; private networks and commercial operators set their own rules. In
      practice it caps an SF12 sensor at about a dozen 51-byte packets a day.
    </p>
    <h3>Low data rate optimisation</h3>
    <p>
      At long symbol times the oscillator drift over a packet becomes significant. LDRO makes the modem carry two fewer
      bits per symbol (the SF − 2·DE term) so the receiver can track the signal. Semtech mandates it when the symbol
      duration exceeds 16 ms, which at 125 kHz means SF11 and SF12, and at 250 kHz only SF12. Transmitter and receiver
      must use the same setting, or the payload will not decode. LoRaWAN stacks set it automatically per data rate.
    </p>
    <h3>ADR, dwell time and payload limits</h3>
    <p>
      Adaptive Data Rate lets the network move a static node to the fastest data rate its link margin allows, which
      shortens airtime, saves battery and frees channel capacity for everyone. LoRaWAN's maximum payload per data rate
      follows from airtime: in the US915 band, FCC rules limit a 125 kHz uplink to 400 ms, so DR0 (SF10) allows only 11
      bytes of application payload, and SF11/SF12 are not used for uplinks at all. AS923 and AU915 apply the same 400 ms
      limit when the network sets UplinkDwellTime. Remember that LoRaWAN adds at least 13 bytes of framing to your
      application payload, more when MAC commands ride along in FOpts.
    </p>
    <p>
      For cellular IoT alternatives, compare with the <a href={toolUrl('psm-edrx')}>LTE-M / NB-IoT PSM and eDRX calculator</a>.
    </p>
  </Fragment>
</ToolLayout>

<style>
  .airbar {
    margin: var(--s4) 0 0;
  }
  .airbar svg {
    display: block;
    width: 100%;
    height: 1.75rem;
    border-radius: var(--radius);
  }
  .airbar figcaption {
    margin-top: var(--s2);
    font-size: var(--text-sm);
    color: var(--ink-muted);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s1) var(--s2);
  }
  .airbar figcaption [data-result] {
    font-family: var(--font-mono);
    color: var(--ink);
    margin-right: var(--s3);
  }
  .lg {
    display: inline-flex;
    align-items: center;
    gap: var(--s1);
    white-space: nowrap;
  }
  .sw {
    display: inline-block;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 2px;
    border: 1px solid var(--rule);
  }
  .sw--pre {
    background: var(--ink-muted);
  }
  .sw--hdr {
    background: var(--rule);
  }
  .sw--pay {
    background: var(--accent);
  }
  .sec-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s3);
    flex-wrap: wrap;
  }
  .sec-head h2 {
    margin-bottom: var(--s3);
  }
  .use-btn {
    padding: 0.1rem 0.5rem;
    font-size: var(--text-sm);
  }
</style>

<script>
  import { bindForm, clearResults, esc, setError, setResult, show } from '../../scripts/tool-client';
  import { formatDuration, formatNumber, formatSI, parseNumber } from '../../lib/format';
  import {
    LDRO_THRESHOLD_S,
    LORAWAN_OVERHEAD_BYTES,
    PAYLOAD_MAX,
    dutyCycleOffTime,
    effectivePayloadRate,
    fairUseMessagesPerDay,
    ldroRequired,
    loraTimeOnAir,
    maxMessages,
    rawBitRate,
    sfSweep,
    validateLora,
    type LdroMode,
    type LoraParams,
  } from '../../lib/lora';
  import { dwellLimit, findDataRate, getRegion, hasDwellParam, payloadLimit, REGIONS } from '../../lib/lorawan-regions';

  const RESULTS = ['toa', 'tsym', 'tpre', 'npay', 'tpay', 'pl', 'ldroState', 'rb', 'reff', 'off', 'mph', 'mpd', 'ttn', 'vpre', 'vhdr', 'vpay'];
  const form = document.getElementById('lora-form') as HTMLFormElement;
  const sfBody = document.getElementById('sf-body')!;
  const drBody = document.getElementById('dr-body')!;
  const sfCopy = document.getElementById('sf-copy')!;
  const svg = document.getElementById('airbar-svg')!;

  const ms = (s: number) => `${formatNumber(s * 1000, 7)} ms`;
  const count = (n: number) => n.toLocaleString('en-US');

  function intField(name: string, raw: string, label: string): number | null {
    const v = parseNumber(raw);
    if (v === null) return setError(name, `${label} must be a number.`), null;
    return v;
  }

  function drawBar(preSym: number, nPayload: number) {
    const total = preSym + nPayload;
    const w = (n: number) => (n / total) * 1000;
    const a = w(preSym);
    const b = w(Math.min(8, nPayload));
    svg.innerHTML =
      `<rect x="0" y="0" width="${a.toFixed(2)}" height="28" fill="var(--ink-muted)"></rect>` +
      `<rect x="${a.toFixed(2)}" y="0" width="${b.toFixed(2)}" height="28" fill="var(--rule)"></rect>` +
      `<rect x="${(a + b).toFixed(2)}" y="0" width="${(1000 - a - b).toFixed(2)}" height="28" fill="var(--accent)"></rect>`;
  }

  function renderRegion(v: Record<string, string>, p: LoraParams | null) {
    const region = getRegion(v.region) ?? REGIONS[0];
    const dwellParam = hasDwellParam(region);
    show('dwell-field', dwellParam);
    const dwellOn = dwellParam && v.dwell === '1';
    const rep = v.rep === '1';
    document.getElementById('region-note')!.textContent = region.note;
    document.getElementById('region-src')!.textContent = region.source;

    const current = p ? findDataRate(region, p.sf, p.bw) : undefined;
    const rows = region.dataRates.map((d) => {
      const lim = payloadLimit(d, dwellOn);
      const limit = dwellLimit(region, d.bw, dwellOn);
      const base = p ?? { sf: d.sf, bw: d.bw, cr: 1, payload: 0, preamble: 8, implicitHeader: false, crc: true, ldro: 'auto' as LdroMode };
      const mod = `SF${d.sf} / ${d.bw / 1000} kHz`;
      let maxCell = '—';
      let mCell = 'N/A';
      let nCell = 'N/A';
      if (lim) {
        const m = rep ? lim.mRepeater : lim.m;
        const n = rep ? lim.nRepeater : lim.n;
        mCell = String(m);
        nCell = String(n);
        const tMax = loraTimeOnAir({ ...base, sf: d.sf, bw: d.bw, payload: m + 5 }).timeOnAir;
        maxCell = ms(tMax);
      }
      let yourCell = '—';
      let flag = '';
      if (p) {
        const t = loraTimeOnAir({ ...p, sf: d.sf, bw: d.bw }).timeOnAir;
        yourCell = ms(t);
        const tooBig = lim ? p.payload > (rep ? lim.mRepeater : lim.m) + 5 : true;
        if (!lim) flag = ' <span class="badge badge--warn">not allowed</span>';
        else if (!d.downlinkOnly && limit !== null && t > limit) flag = ' <span class="badge badge--warn">&gt; 400 ms</span>';
        else if (tooBig) flag = ' <span class="badge badge--warn">too long</span>';
      }
      const dir = d.downlinkOnly ? 'Downlink only' : 'Up / down';
      const cls = current && current.dr === d.dr ? ' class="is-current"' : '';
      return (
        `<tr${cls}><td class="mono">DR${d.dr}</td><td>${esc(mod)}</td><td>${dir}</td>` +
        `<td class="num">${mCell}</td><td class="num">${nCell}</td><td class="num">${maxCell}</td>` +
        `<td class="num">${yourCell}${flag}</td>` +
        `<td><button class="btn use-btn" type="button" data-sf="${d.sf}" data-bw="${d.bw / 1000}" aria-label="Use DR${d.dr} (SF${d.sf}, ${d.bw / 1000} kHz)">Use</button></td></tr>`
      );
    });
    drBody.innerHTML = rows.join('');

    const match = document.getElementById('region-match')!;
    match.className = 'note';
    if (!p) {
      match.textContent = '';
      return;
    }
    if (!current) {
      match.className = 'note note--warn';
      match.textContent = `SF${p.sf} / ${p.bw / 1000} kHz is not a LoRaWAN data rate in ${region.name}.`;
    } else {
      const lim = payloadLimit(current, dwellOn);
      if (!lim) {
        match.className = 'note note--warn';
        match.textContent = `DR${current.dr} is not allowed with UplinkDwellTime = 1 in ${region.name}.`;
      } else {
        const m = rep ? lim.mRepeater : lim.m;
        const n = rep ? lim.nRepeater : lim.n;
        const app = p.payload - LORAWAN_OVERHEAD_BYTES;
        const fits = p.payload <= m + 5;
        match.className = fits ? 'note note--ok' : 'note note--warn';
        match.textContent =
          `Your settings are ${region.name} DR${current.dr}${current.downlinkOnly ? ' (downlink only)' : ''}: ` +
          `max application payload N = ${n} B (PHY ${m + 5} B). ` +
          (app < 0
            ? `A ${p.payload} B PHY payload is shorter than the 13 B LoRaWAN minimum frame.`
            : fits
              ? `Your ${app} B application payload fits.`
              : `Your ${app} B application payload is ${app - n} B too long.`);
      }
    }
  }

  const run = bindForm(form, (v) => {
    const sf = Number(v.sf);
    const bw = Number(v.bw) * 1000;
    const cr = Number(v.cr);
    const lw = v.lw === '1';
    const dcPct = Number(v.dc);
    const dc = dcPct / 100;
    setResult('dcLabel', `${v.dc} %`);

    const payIn = intField('payload', v.payload, 'Payload length');
    const pre = intField('preamble', v.preamble, 'Preamble length');
    const p: LoraParams = {
      sf,
      bw,
      cr,
      payload: payIn === null ? NaN : lw ? payIn + LORAWAN_OVERHEAD_BYTES : payIn,
      preamble: pre ?? NaN,
      implicitHeader: v.hdr === 'implicit',
      crc: v.crc === '1',
      ldro: (['auto', 'on', 'off'].includes(v.ldro) ? v.ldro : 'auto') as LdroMode,
    };
    const errs = validateLora(p);
    if (errs.payload && payIn !== null && lw && Number.isInteger(payIn) && payIn >= 0)
      errs.payload = `With the 13 B LoRaWAN overhead the application payload can be at most ${PAYLOAD_MAX - LORAWAN_OVERHEAD_BYTES} bytes.`;
    else if (errs.payload && lw) errs.payload = `Application payload must be a whole number of bytes from 0 to ${PAYLOAD_MAX - LORAWAN_OVERHEAD_BYTES}.`;
    if (payIn !== null) setError('payload', errs.payload ?? null);
    if (pre !== null) setError('preamble', errs.preamble ?? null);
    setError('sf', errs.sf ?? null);
    setError('bw', errs.bw ?? null);
    setError('cr', errs.cr ?? null);
    if (!Number.isFinite(dc) || ![0.1, 1, 10].includes(dcPct)) setError('dc', 'Duty cycle must be 0.1 %, 1 % or 10 %.');
    else setError('dc', null);

    const invalid = payIn === null || pre === null || Object.keys(errs).length > 0 || ![0.1, 1, 10].includes(dcPct);
    if (invalid) {
      clearResults(...RESULTS);
      sfBody.innerHTML = '';
      sfCopy.dataset.copyText = '';
      show('ldro-note', false);
      show('dwell-note', false);
      renderRegion(v, null);
      return;
    }

    const r = loraTimeOnAir(p);
    setResult('toa', formatNumber(r.timeOnAir * 1000, 7));
    setResult('tsym', formatSI(r.symbolTime, 's'));
    setResult('tpre', `${formatSI(r.preambleTime, 's')} (${formatNumber(r.preambleSymbols)} sym)`);
    setResult('npay', String(r.payloadSymbols));
    setResult('tpay', formatSI(r.payloadTime, 's'));
    setResult('pl', lw ? `${p.payload} (${payIn} + 13)` : String(p.payload));
    const need = ldroRequired(sf, bw);
    setResult('ldroState', `${r.ldro ? 'On' : 'Off'}${p.ldro === 'auto' ? ` (auto: Tsym ${need ? '>' : '≤'} 16 ms)` : ''}`);
    setResult('rb', formatSI(rawBitRate(sf, bw, cr), 'bit/s'));
    setResult('reff', formatSI(effectivePayloadRate(p.payload, r.timeOnAir), 'bit/s'));
    setResult('off', formatDuration(dutyCycleOffTime(r.timeOnAir, dc)));
    setResult('mph', count(maxMessages(r.timeOnAir, dc, 3600)));
    setResult('mpd', count(maxMessages(r.timeOnAir, dc, 86400)));
    setResult('ttn', count(fairUseMessagesPerDay(r.timeOnAir)));

    const ldroNote = document.getElementById('ldro-note')!;
    if (!r.ldro && need) {
      ldroNote.textContent = `Symbol time ${formatSI(r.symbolTime, 's')} exceeds ${LDRO_THRESHOLD_S * 1000} ms: Semtech mandates LDRO here. Both ends must use the same setting.`;
      show('ldro-note', true);
    } else show('ldro-note', false);

    const region = getRegion(v.region) ?? REGIONS[0];
    const limit = dwellLimit(region, bw, hasDwellParam(region) && v.dwell === '1');
    const dwellNote = document.getElementById('dwell-note')!;
    if (limit !== null && r.timeOnAir > limit) {
      dwellNote.textContent = `Time on air exceeds the ${limit * 1000} ms uplink dwell-time limit in ${region.name} — ${region.dwell === 'fcc-400ms-below-500khz' ? 'FCC rule for channels below 500 kHz' : 'UplinkDwellTime = 1'}.`;
      show('dwell-note', true);
    } else show('dwell-note', false);

    const preSym = r.preambleSymbols;
    setResult('vpre', `${formatNumber(preSym)} sym`);
    setResult('vhdr', '8 sym');
    setResult('vpay', `${r.payloadSymbols - 8} sym`);
    drawBar(preSym, r.payloadSymbols);

    const sweep = sfSweep(p);
    const tsv = ['SF\tLDRO\tTsym (ms)\tPayload symbols\tToA (ms)\tOff time (s)\tMsgs/day (' + v.dc + ' %)\tMsgs/day (TTN 30 s)'];
    sfBody.innerHTML = sweep
      .map((row) => {
        const off = dutyCycleOffTime(row.timeOnAir, dc);
        const day = maxMessages(row.timeOnAir, dc, 86400);
        const ttn = fairUseMessagesPerDay(row.timeOnAir);
        tsv.push(
          [`SF${row.sf}`, row.ldro ? 'on' : 'off', formatNumber(row.symbolTime * 1000), row.payloadSymbols, formatNumber(row.timeOnAir * 1000, 7), formatNumber(off, 6), day, ttn].join('\t'),
        );
        return (
          `<tr${row.sf === sf ? ' class="is-current"' : ''}><td class="mono">SF${row.sf}</td><td>${row.ldro ? 'on' : 'off'}</td>` +
          `<td class="num">${esc(formatSI(row.symbolTime, 's'))}</td><td class="num">${row.payloadSymbols}</td>` +
          `<td class="num">${esc(ms(row.timeOnAir))}</td><td class="num">${esc(formatDuration(off))}</td>` +
          `<td class="num">${count(day)}</td><td class="num">${count(ttn)}</td></tr>`
        );
      })
      .join('');
    sfCopy.dataset.copyText = tsv.join('\n');

    renderRegion(v, p);
  });

  drBody.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-sf]');
    if (!btn) return;
    const setRadio = (name: string, value: string) => {
      const el = form.querySelector<HTMLInputElement>(`input[name="${name}"][value="${value}"]`);
      if (el) el.checked = true;
    };
    setRadio('sf', btn.dataset.sf!);
    setRadio('bw', btn.dataset.bw!);
    run();
    document.getElementById('r-toa')?.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'center' });
  });
</script>
