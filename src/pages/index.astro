---
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryIcon from '../components/CategoryIcon.astro';
import ToolIcon from '../components/ToolIcon.astro';
import { SITE } from '../config';
import { CATEGORIES, TOOLS } from '../tools';
import { toolUrl, url } from '../utils/paths';

const groups = CATEGORIES.map((c) => ({ ...c, tools: TOOLS.filter((t) => t.category === c.id) }));
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  description: SITE.tagline,
  url: Astro.site ? new URL(import.meta.env.BASE_URL, Astro.site).href : undefined,
  author: { '@type': 'Person', name: SITE.owner, jobTitle: SITE.role, sameAs: [SITE.github, SITE.linkedin] },
};
---

<BaseLayout
  description="Spec-referenced calculators for embedded engineers: LTE-M/NB-IoT PSM & eDRX, LoRa airtime, STM32 timers, CAN bit timing, CRC, IEEE-754 and analog design."
  jsonLd={jsonLd}
>
  <section class="hero">
    <p class="eyebrow"><span class="dot" aria-hidden="true"></span> Free engineering calculators · by {SITE.owner}</p>
    <h1>Precision calculators for <span class="hl">embedded systems engineers.</span></h1>
    <p class="lede">
      {TOOLS.length} engineering calculators for firmware and hardware design, covering cellular IoT and LoRa, MCU
      peripherals such as timers, CAN and I²C, data formats and analog front ends. Each tool documents its formula and
      cites the specification or datasheet it is based on. All calculations run locally in your browser.
    </p>
    <div class="search">
      <svg class="search-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path>
      </svg>
      <label for="tool-search" class="visually-hidden">Filter tools</label>
      <input id="tool-search" type="search" placeholder="Search tools: eDRX, CRC, STM32…" autocomplete="off" />
      <kbd aria-hidden="true">/</kbd>
    </div>
    <ul class="features" aria-label="Why BitBench">
      <li><svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="m3.5 8.5 3 3 6-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>Formulas cite the spec</li>
      <li><svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="m3.5 8.5 3 3 6-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>Unit-tested logic</li>
      <li><svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="m3.5 8.5 3 3 6-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>Shareable result links</li>
      <li><svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="m3.5 8.5 3 3 6-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>Works offline, no tracking</li>
    </ul>
    <nav class="jump" aria-label="Categories">
      {
        groups.map((g) => (
          <a href={`#cat-${g.id}`} class={`jump-link cat--${g.id}`}>
            <CategoryIcon id={g.id} size={16} />
            {g.label}
          </a>
        ))
      }
    </nav>
  </section>

  <div class="directory">
    {
      groups.map((g) => (
        <section class={`cat cat--${g.id}`} data-group id={`cat-${g.id}`} aria-labelledby={`cat-${g.id}-title`}>
          <header class="cat-head">
            <span class="cat-icon">
              <CategoryIcon id={g.id} />
            </span>
            <div class="cat-text">
              <h2 id={`cat-${g.id}-title`}>{g.label}</h2>
              <p>{g.blurb}</p>
            </div>
            <span class="cat-count">
              {g.tools.length} {g.tools.length === 1 ? 'tool' : 'tools'}
            </span>
          </header>
          <ul class="cat-tools">
            {g.tools.map((t) => (
              <li data-tool data-search={[t.name, t.title, t.description, g.label, ...t.keywords].join(' ').toLowerCase()}>
                <a href={toolUrl(t.slug)}>
                  <span class="t-icon">
                    <ToolIcon slug={t.slug} />
                  </span>
                  <span class="t-name">{t.name}</span>
                  <span class="t-desc">{t.description}</span>
                  <svg class="t-arrow" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M6 3.5 10.5 8 6 12.5" />
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
  <p id="no-match" class="note" hidden>
    No tool matches that. <a href={url('contact/')}>Suggest it</a> and I'll consider building it.
  </p>
</BaseLayout>

<script>
  const input = document.getElementById('tool-search') as HTMLInputElement;
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-tool]'));
  const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-group]'));
  const noMatch = document.getElementById('no-match')!;

  function filter() {
    const terms = input.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
    let any = false;
    for (const li of items) {
      const hit = terms.every((t) => li.dataset.search!.includes(t));
      li.hidden = !hit;
      any ||= hit;
    }
    for (const g of groups) g.hidden = !g.querySelector('[data-tool]:not([hidden])');
    noMatch.hidden = any;
  }
  input.addEventListener('input', filter);
  document.addEventListener('keydown', (e) => {
    if (e.key === '/' && document.activeElement !== input && !(e.target as HTMLElement).matches('input, textarea, select')) {
      e.preventDefault();
      input.focus();
    }
  });
</script>

<style>
  .hero {
    position: relative;
    padding: clamp(var(--s6), 6vw, var(--s8)) 0 clamp(var(--s5), 5vw, var(--s7));
    text-align: center;
    isolation: isolate;
  }
  /* Full-bleed engineering-paper grid that fades out towards the edges. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0 calc(50% - 50vw);
    z-index: -1;
    background-image: linear-gradient(var(--rule) 1px, transparent 1px),
      linear-gradient(90deg, var(--rule) 1px, transparent 1px);
    background-size: 28px 28px;
    background-position: center top;
    mask-image: radial-gradient(ellipse 60% 75% at 50% 35%, #000 20%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 60% 75% at 50% 35%, #000 20%, transparent 75%);
    opacity: 0.8;
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--s2);
    margin: 0 0 var(--s4);
    padding: 0.2rem 0.75rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--ink-muted);
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 999px;
    box-shadow: var(--shadow);
  }
  .eyebrow .dot {
    position: relative;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--ok);
  }
  /* Status LED: a soft ring breathes out every few seconds. */
  .eyebrow .dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--ok);
    animation: led 2.4s ease-out infinite;
  }
  @keyframes led {
    0% {
      transform: scale(1);
      opacity: 0.55;
    }
    70%,
    100% {
      transform: scale(3);
      opacity: 0;
    }
  }

  .hl {
    color: var(--accent);
    display: block;
  }
  .features {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s2) var(--s5);
    list-style: none;
    margin: var(--s5) 0 0;
    padding: 0;
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }
  .features li {
    display: inline-flex;
    align-items: center;
    gap: var(--s2);
  }
  .features svg {
    color: var(--ok);
  }
  .hero h1 {
    font-size: clamp(2rem, 4vw + 0.6rem, 3.25rem);
    font-weight: 750;
    max-width: 28ch;
    margin: 0 auto var(--s4);
    letter-spacing: -0.035em;
    line-height: 1.1;
  }
  .hero .lede {
    margin: 0 auto var(--s5);
  }
  .search {
    position: relative;
    max-width: 36rem;
    margin: 0 auto;
  }
  .search input {
    width: 100%;
    font: inherit;
    font-size: var(--text-lg);
    padding: var(--s3) var(--s7) var(--s3) calc(var(--s4) + 26px);
    background: var(--surface);
    color: var(--ink);
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    box-shadow: var(--shadow);
  }
  .search input:focus-visible {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }
  .search-icon {
    position: absolute;
    left: var(--s4);
    top: 50%;
    transform: translateY(-50%);
    color: var(--ink-muted);
    pointer-events: none;
  }
  .search kbd {
    position: absolute;
    right: var(--s4);
    top: 50%;
    transform: translateY(-50%);
    font-size: var(--text-sm);
    color: var(--ink-muted);
    background: var(--surface-2);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: 0 0.45rem;
  }
  @media (max-width: 30rem) {
    .search kbd {
      display: none;
    }
    .search input {
      padding-right: var(--s4);
    }
  }
  .jump {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s2);
    margin-top: var(--s5);
  }
  .jump-link {
    display: inline-flex;
    align-items: center;
    gap: var(--s2);
    padding: var(--s1) var(--s3);
    border-radius: 999px;
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--rule);
  }
  .jump-link :global(svg) {
    color: var(--cat);
  }
  .jump-link {
    transition:
      transform 0.15s var(--ease-out),
      box-shadow 0.15s var(--ease-out);
  }
  .jump-link:hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow);
  }

  /* Category hues */

  .directory {
    display: grid;
    gap: var(--s5);
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
  }
  @media (min-width: 60rem) {
    .directory {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .cat {
    border-top: 2px solid color-mix(in srgb, var(--cat) 70%, transparent) !important;
    transition:
      transform 0.2s var(--ease-out),
      box-shadow 0.2s var(--ease-out);
    background: var(--surface);
    border: 1px solid var(--rule);

    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    overflow: hidden;
    scroll-margin-top: 5rem;
  }
  .cat:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-hover);
  }
  .cat-head {
    display: flex;
    align-items: center;
    gap: var(--s3);
    padding: var(--s4) var(--s5);
    border-bottom: 1px solid var(--rule);
  }
  .cat-icon {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius);
    color: var(--cat);
    background: var(--cat-soft);
  }
  .cat-text {
    flex: 1 1 auto;
    min-width: 0;
  }
  .cat-text h2 {
    font-size: var(--text-lg);
    margin: 0;
  }
  .cat-text p {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }
  .cat-count {
    flex: 0 0 auto;
    font-size: 0.75rem;
    font-weight: 650;
    color: var(--ink-muted);
    background: var(--surface-2);
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 0.1rem 0.6rem;
  }
  .cat-tools {
    list-style: none;
    margin: 0;
    padding: var(--s2);
  }
  .cat-tools a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    column-gap: var(--s3);
    padding: var(--s3);
    border-radius: var(--radius);
    color: var(--ink);
    text-decoration: none;
    transition: background 0.15s;
  }
  .cat-tools a:hover {
    background: var(--surface-2);
  }
  .cat-tools a:hover .t-name {
    color: var(--accent);
  }
  .cat-tools a:hover .t-arrow {
    color: var(--accent);
    transform: translateX(2px);
  }
  .t-icon {
    grid-column: 1;
    grid-row: 1 / span 2;
    align-self: start;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    margin-top: 0.1rem;
    border-radius: var(--radius);
    color: var(--cat);
    background: var(--surface-2);
    border: 1px solid var(--rule);
    transition: background 0.15s, border-color 0.15s;
  }
  .cat-tools a:hover .t-icon {
    background: var(--cat-soft);
    border-color: transparent;
  }
  .t-name {
    font-weight: 650;
    grid-column: 2;
  }
  .t-desc {
    grid-column: 2;
    font-size: var(--text-sm);
    color: var(--ink-muted);
    line-height: 1.5;
  }
  .t-arrow {
    grid-column: 3;
    grid-row: 1 / span 2;
    align-self: center;
    color: var(--rule-strong);
    transition: transform 0.15s, color 0.15s;
  }
  @media (max-width: 30rem) {
    .cat-head {
      padding: var(--s3) var(--s4);
    }
    .cat-count {
      display: none;
    }
  }
</style>
